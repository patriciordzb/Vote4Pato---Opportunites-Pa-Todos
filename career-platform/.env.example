# ---------------------------------------------------------------------------
# SHPE 2026 Career Intelligence Command Center: environment variables
# Copy to .env.local for local development. Never commit real values.
# ---------------------------------------------------------------------------

# --- App sign-in (REQUIRED in production) ---------------------------------
# Password for this single-owner app. If unset in development, the app runs
# in "local mode" with no password. In production, sign-in is refused until it is set.
APP_PASSWORD=
# 32+ random characters used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# 32 random bytes, base64. Encrypts LinkedIn access tokens at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Public URL of the deployment (used for the LinkedIn OAuth redirect URI)
APP_URL=http://localhost:3000

# --- Database ---------------------------------------------------------------
# PostgreSQL connection string (Supabase: Project Settings → Database →
# Connection string → "Transaction pooler" URI). If unset, the app uses an
# embedded PGlite database stored in PGLITE_DIR. That's fine locally, but not
# on serverless hosts.
DATABASE_URL=
# PGLITE_DIR=.data/pglite
# DATABASE_POOL_MAX=5
# Set to "false" only if your Postgres provider uses a self-signed certificate.
# DATABASE_SSL_REJECT_UNAUTHORIZED=true

# --- LinkedIn (optional) ----------------------------------------------------
# From https://www.linkedin.com/developers/apps → your app → Auth.
# Product needed: "Sign In with LinkedIn using OpenID Connect".
# Authorized redirect URL: ${APP_URL}/api/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- AI (optional) ----------------------------------------------------------
# Enables the AI assistant, AI recruiter mock interviews, AI message
# personalization, AI resume extraction and resume-to-job analysis.
# Without it, every feature falls back to the rule-based engine.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
